{
  "$comment": "社区版导出清单。include 取文件，drop 删私人模块，scrub 做注释与文案脱敏，overlay/ 目录的文件最后覆盖进去。改动后跑 node scripts/community/export-community.js 与 tests/unit-community-export.test.js。",
  "version": "0.4.5",
  "include": [
    "main.js",
    "main-bootstrap.js",
    "package.json",
    "package-lock.json",
    "LICENSE",
    "claude-wx.ico",
    "core/**",
    "main/**",
    "renderer/**",
    "scripts/brand-hub-exe.js",
    "scripts/claude-hub-statusline.js",
    "scripts/deepseek_repl.py",
    "scripts/desktop-icon-layout.cs",
    "scripts/desktop-icon-layout.ps1",
    "scripts/firewall-whitelist-electron.ps1",
    "scripts/open-hub-github-auth.js",
    "scripts/ask-home.js",
    "scripts/ask-home-mcp.js",
    "scripts/orchestrator-mcp.js",
    "scripts/prepared-projects.js",
    "scripts/provider-cli-hook.js",
    "scripts/provider-cli-tap.js",
    "scripts/repair-claude-hook-integration.js",
    "scripts/repair-windows-shell-integration.js",
    "scripts/session-hub-hook.ps1",
    "scripts/session-hub-hook.py",
    "scripts/share-agent-skills.js",
    "tools/hub-escape.ps1",
    "tools/hub-escape-foreground.ps1",
    "tests/helpers/hub-launcher.js",
    "tests/helpers/cdp-client.js",
    "tests/fixtures/codeagent-standin/**",
    "tests/e2e-codeagent-standin-real-cli.js",
    "tests/acceptance-codeagent-real.js",
    "tests/diagnose-codeagent.js",
    "tests/e2e-codeagent-terminal-env.js",
    "tests/e2e-company-no-assistant.js",
    "tests/diagnose-backstage-freeze.js",
    "tests/e2e-window-occlusion-keeps-rendering.js",
    "tests/unit-window-keep-rendering.test.js",
    "tests/unit-renderer-crash-recovery.test.js",
    "tests/e2e-renderer-crash-recovery-cdp.js",
    "tests/unit-session-search-first-build.test.js",
    "tests/e2e-search-first-build-idle-cdp.js",
    "tests/unit-backstage-path.test.js",
    "tests/repro-backstage-render.js",
    "tests/fixtures/codeagent-tui-standin/**",
    "tests/fixtures/codeagent-env-echo.cmd"
  ],
  "drop": [
    "core/cloud/**",
    "main/ipc/cloud-handlers.js",
    "renderer/cloud-page.js",
    "renderer/styles/cloud-page.css",
    "tests/unit-cloud-*.test.js",
    "tests/e2e-cloud-page-cdp.js",
    "renderer/assets/navigation/sticker-v2/research.png",
    "renderer/assets/navigation/sticker-v2/study.png",
    "renderer/assets/navigation/sticker-v2/writing.png",
    "renderer/assets/20261002-selected-artwork.json",
    "renderer/assets/20261002-selected-artwork.md",
    "core/chuxin*",
    "core/lindang-bridge.js",
    "core/research-mcp-server.js",
    "core/screener-score.js",
    "core/committee-*",
    "core/agent-league-*",
    "core/league-keepalive-policy.js",
    "core/study-*",
    "main/ipc/chuxin-handlers.js",
    "main/ipc/committee-handlers.js",
    "main/ipc/agent-league-handlers.js",
    "main/ipc/study-handlers.js",
    "main/ipc/chatgpt-bridge-handlers.js",
    "main/groupchat/committee-conductor.js",
    "renderer/chuxin*",
    "renderer/study*",
    "renderer/committee-ui*",
    "renderer/agent-league*",
    "renderer/chatgpt-bridge-controller.js",
    "core/writing/**",
    "main/ipc/writing-handlers.js",
    "renderer/writing*",
    "core/wireless-assistant/**",
    "main/ipc/wireless-handlers.js",
    "renderer/wireless-page.js",
    "renderer/styles/wireless-page.css",
    "tests/unit-wireless-assistant.test.js",
    "core/company-bridge/home.js",
    "core/company-bridge/home-consult.js",
    "core/company-bridge/team-link.js",
    "core/company-bridge/team-skills.js",
    "core/company-bridge/team-skills/**",
    "tests/unit-company-bridge-team.test.js",
    "tests/e2e-tezhan-team-relay.js",
    "tests/e2e-tezhan-team-ui.js",
    "renderer/company-link-home.js",
    "tests/unit-company-bridge.test.js",
    "tests/unit-bridge-pairing-home.test.js",
    "tests/unit-ask-home.test.js",
    "tests/unit-company-bridge-images.test.js",
    "tests/e2e-bridge-images.js",
    "tests/helpers/bridge-images-ui.py",
    "tests/helpers/company-bridge-rig.js",
    "tests/unit-company-hub-admin.test.js",
    "tests/unit-company-restart-recovery.test.js",
    "tests/unit-company-model-route.test.js",
    "tests/e2e-company-model-route.js",
    "tests/unit-bridge-delivery-guard.test.js",
    "tests/e2e-company-hub-remote-update.js",
    "renderer/company-diag-card.js",
    "tests/unit-company-diag.test.js",
    "tests/e2e-company-diag.js",
    "tests/unit-company-remote-act.test.js",
    "tests/e2e-company-remote-act.js",
    "tests/unit-writing-tab.test.js",
    "tests/e2e-writing-tab-cdp.js",
    "renderer/assets/ai-avatars/v1/**",
    "renderer/assets/navigation/ceramic-navigation.png",
    "renderer/assets/navigation/coldwhite-enamel-v1.png",
    "scripts/community/shrink-images.ps1"
  ],
  "scrub": [
    {
      "pattern": "立花道雪",
      "replace": "maintainer"
    },
    {
      "pattern": "道雪",
      "replace": "maintainer"
    },
    {
      "pattern": "田哥",
      "replace": "用户"
    },
    {
      "pattern": "林田",
      "replace": "用户"
    },
    {
      "pattern": "C:\\\\\\\\Users\\\\\\\\lintian",
      "replace": "C:\\\\Users\\\\you"
    },
    {
      "pattern": "C:\\\\Users\\\\lintian",
      "replace": "C:\\Users\\you"
    },
    {
      "pattern": "C:/Users/lintian",
      "replace": "C:/Users/you"
    },
    {
      "pattern": "C--Users-lintian",
      "replace": "C--Users-you"
    },
    {
      "pattern": "初心投研",
      "replace": "扩展投研"
    },
    {
      "pattern": "初心",
      "replace": "扩展投研"
    },
    {
      "pattern": "LinDangAgent",
      "replace": "ResearchAgent"
    },
    {
      "pattern": "LinDang",
      "replace": "ResearchAgent"
    },
    {
      "pattern": "lindang",
      "replace": "researchagent"
    },
    {
      "pattern": "CHUXIN",
      "replace": "XRESEARCH"
    },
    {
      "pattern": "Chuxin",
      "replace": "Xresearch"
    },
    {
      "pattern": "chuxin",
      "replace": "xresearch"
    },
    {
      "pattern": "C:(\\\\\\\\|\\\\|/)VibeData",
      "replace": "C:$1AppData"
    },
    {
      "pattern": "VibeData",
      "replace": "AppData"
    },
    {
      "pattern": "C:(\\\\\\\\|\\\\|/)Vibe(?![A-Za-z])",
      "replace": "C:$1Workspace"
    },
    {
      "pattern": "C:(\\\\\\\\|\\\\|/)DevTools",
      "replace": "C:$1Tools"
    },
    {
      "pattern": "C:(\\\\\\\\|\\\\|/)AIWork",
      "replace": "C:$1Work"
    },
    {
      "pattern": "CodexWebGPT",
      "replace": "WebGPT"
    },
    {
      "pattern": "Meridian",
      "replace": "网关"
    },
    {
      "pattern": "lintian",
      "replace": "you"
    },
    {
      "pattern": "[Ss]uper(?:RAN|ran)",
      "replace": "wireless-sim"
    },
    {
      "pattern": "chatgpt-bridge",
      "replace": "relay-tool"
    },
    {
      "pattern": "\\.claude-session-hub",
      "replace": ".ai-hub-community"
    },
    {
      "pattern": "AI 群聊 Hub",
      "replace": "AI Hub Community"
    },
    {
      "pattern": "com\\.ai-group-chat-hub",
      "replace": "com.ai-hub.community"
    },
    {
      "pattern": "AIGroupChatHub",
      "replace": "AIHubCommunity"
    }
  ],
  "package": {
    "name": "ai-hub-community",
    "description": "Local multi-agent desktop workspace using your own AI accounts",
    "license": "MIT",
    "repository": {
      "type": "git",
      "url": "https://github.com/TianLin0509/ai-hub-community.git"
    },
    "engines": {
      "node": ">=22"
    },
    "scripts": {
      "start": "electron .",
      "test": "node --test tests/unit-community.test.js tests/unit-community-onboarding.test.js tests/unit-community-hooks.test.js",
      "dist": "electron-builder --win --publish never",
      "doctor": "node scripts/doctor.js",
      "audit": "node scripts/audit-public.js"
    },
    "build": {
      "appId": "com.ai-hub.community",
      "productName": "AI Hub Community",
      "extraResources": [
        {
          "from": "scripts",
          "to": "scripts",
          "filter": [
            "**/*",
            "!firewall-whitelist-electron.ps1"
          ]
        },
        {
          "from": "docs",
          "to": "guides/docs",
          "filter": [
            "**/*.md"
          ]
        },
        {
          "from": ".",
          "to": "guides",
          "filter": [
            "README.md",
            "INSTALL.md",
            "AGENTS.md",
            "PRIVACY.md"
          ]
        }
      ],
      "win": {
        "target": [
          "nsis",
          "zip"
        ],
        "icon": "claude-wx.ico",
        "artifactName": "AIHubCommunity-${version}-win-${arch}.${ext}"
      },
      "nsis": {
        "artifactName": "AIHubCommunity-Setup-${version}.${ext}",
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "installerIcon": "claude-wx.ico",
        "uninstallerIcon": "claude-wx.ico",
        "createDesktopShortcut": true
      },
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "buildFilesAppend": [
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/scripts/**",
      "!node_modules/node-pty/typings/**",
      "!node_modules/node-pty/binding.gyp"
    ]
  },
  "shrinkImages": {
    "renderer/assets/ai-avatars": 384,
    "renderer/assets/navigation": 256
  }
}
